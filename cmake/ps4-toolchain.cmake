set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(KSTAR_GFX_BACKEND GNM CACHE STRING "" FORCE)
set(OO_PS4_TOOLCHAIN "$ENV{OO_PS4_TOOLCHAIN}" CACHE PATH "OpenOrbis SDK")
if(NOT EXISTS "${OO_PS4_TOOLCHAIN}/lib/crt1.o")
  message(FATAL_ERROR "OO_PS4_TOOLCHAIN must contain lib/crt1.o")
endif()
set(CMAKE_C_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_SYSROOT "${OO_PS4_TOOLCHAIN}")
set(CMAKE_FIND_ROOT_PATH "${OO_PS4_TOOLCHAIN}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
# The ABI correction is maintained as source, never rewritten during a build.
file(READ "${CMAKE_CURRENT_LIST_DIR}/../deps/sdk-compat.json" _kgfx_sdk_compat)
string(JSON _kgfx_expected_types GET "${_kgfx_sdk_compat}" source_header_sha256)
file(SHA256 "${OO_PS4_TOOLCHAIN}/include/bits/alltypes.h" _kgfx_sdk_types_hash)
if(NOT _kgfx_sdk_types_hash STREQUAL _kgfx_expected_types)
  message(FATAL_ERROR "OpenOrbis type header differs from deps/sdk-compat.json; review the maintained SDK compatibility header before using this SDK")
endif()
configure_file("${CMAKE_CURRENT_LIST_DIR}/../src/gnm/sdk-include/bits/alltypes.h"
  "${CMAKE_BINARY_DIR}/sdk-include/bits/alltypes.h" COPYONLY)
set(CMAKE_C_FLAGS_INIT "-fPIC -funwind-tables -D_GNU_SOURCE -D__ORBIS__ -isystem \"${CMAKE_BINARY_DIR}/sdk-include\" -isystem \"${OO_PS4_TOOLCHAIN}/include\"")
set(CMAKE_CXX_FLAGS_INIT "-nostdinc++ -isystem \"${OO_PS4_TOOLCHAIN}/include/c++/v1\" ${CMAKE_C_FLAGS_INIT}")
set(CMAKE_C_LINK_EXECUTABLE "<CMAKE_LINKER> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
set(CMAKE_CXX_LINK_EXECUTABLE "${CMAKE_C_LINK_EXECUTABLE}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-m elf_x86_64 -pie --eh-frame-hdr -T\"${OO_PS4_TOOLCHAIN}/link.x\" -L\"${OO_PS4_TOOLCHAIN}/lib\" \"${OO_PS4_TOOLCHAIN}/lib/crt1.o\"")
set(CMAKE_C_STANDARD_LIBRARIES "-lc -lkernel" CACHE STRING "PS4 runtime")
set(CMAKE_CXX_STANDARD_LIBRARIES "-lc++ -lc -lkernel" CACHE STRING "PS4 runtime")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES OO_PS4_TOOLCHAIN CMAKE_LINKER CMAKE_AR CMAKE_RANLIB)
