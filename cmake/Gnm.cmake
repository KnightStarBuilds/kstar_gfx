include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/AcquireInputs.cmake")
function(kgfx_prepare_opengnm_source out)
    kgfx_tool_source(opengnm opengnm_source)
    set(${out} "${opengnm_source}" PARENT_SCOPE)
endfunction()

function(kgfx_configure_gnm target)
    if(NOT CMAKE_SYSTEM_PROCESSOR STREQUAL "x86_64" OR NOT CMAKE_CROSSCOMPILING)
        message(FATAL_ERROR "GNM requires the OpenOrbis cross toolchain; see cmake/ps4-toolchain.cmake")
    endif()
    kgfx_prepare_opengnm_source(opengnm_source)
    set(OPENGNM_PLATFORM orbis CACHE STRING "" FORCE)
    set(OPENGNM_BUILD_TESTS OFF CACHE BOOL "" FORCE)
    set(OPENGNM_SUBMIT_WRAPPERS OFF CACHE BOOL "" FORCE)
    add_subdirectory("${opengnm_source}" "${CMAKE_CURRENT_BINARY_DIR}/deps/opengnm")
    target_sources(${target} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/gnm/backend.cpp")
    target_link_libraries(${target} PRIVATE opengnm::opengnm SceSysmodule)
    target_compile_definitions(${target} PRIVATE KSTAR_GFX_GNM=1)
endfunction()
