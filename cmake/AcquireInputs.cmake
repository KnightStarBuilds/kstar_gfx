include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/ForkSources.cmake")
# Verify before replacing: failed acquisition never destroys a usable old file.
function(kgfx_download_verified url sha256 destination)
    if(NOT sha256 MATCHES "^[0-9a-fA-F]+$")
        message(FATAL_ERROR "Invalid SHA256 for ${url}")
    endif()
    string(LENGTH "${sha256}" digest_length)
    if(NOT digest_length EQUAL 64)
        message(FATAL_ERROR "SHA256 must have 64 hexadecimal digits: ${url}")
    endif()
    get_filename_component(directory "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    file(LOCK "${destination}.lock" GUARD FUNCTION TIMEOUT 1200)
    if(EXISTS "${destination}")
        file(SHA256 "${destination}" actual)
        if(actual STREQUAL sha256)
            return()
        endif()
    endif()
    if(KSTAR_GFX_OFFLINE)
        message(FATAL_ERROR "Offline input missing or corrupt: ${destination}; required SHA256 ${sha256}")
    endif()
    if(NOT url MATCHES "^https://" AND NOT KSTAR_GFX_TEST_ALLOW_LOCAL_DOWNLOADS)
        message(FATAL_ERROR "Dependency downloads require HTTPS: ${url}")
    endif()
    set(partial "${destination}.part")
    file(REMOVE "${partial}")
    message(STATUS "Acquiring ${url}")
    file(DOWNLOAD "${url}" "${partial}" TLS_VERIFY ON TIMEOUT 600 INACTIVITY_TIMEOUT 60 STATUS status)
    list(GET status 0 code)
    list(GET status 1 detail)
    if(NOT code EQUAL 0)
        file(REMOVE "${partial}")
        message(FATAL_ERROR "Download failed: ${url}: ${detail}; existing input retained")
    endif()
    file(SHA256 "${partial}" actual)
    if(NOT actual STREQUAL sha256)
        file(REMOVE "${partial}")
        message(FATAL_ERROR "SHA256 mismatch for ${url}: expected ${sha256}, received ${actual}; existing input retained")
    endif()
    file(RENAME "${partial}" "${destination}" RESULT result)
    if(NOT result STREQUAL "0")
        file(REMOVE "${partial}")
        message(FATAL_ERROR "Cannot publish verified input ${destination}: ${result}")
    endif()
endfunction()

function(kgfx_acquire_manifest root manifest_path)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest_path}")
    file(READ "${manifest_path}" manifest)
    string(JSON count LENGTH "${manifest}" files)
    if(count EQUAL 0)
        return()
    endif()
    math(EXPR last "${count}-1")
    foreach(index RANGE ${last})
        string(JSON path GET "${manifest}" files ${index} file)
        if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|[/\\])\\.\\.([/\\]|$)")
            message(FATAL_ERROR "Manifest path escapes asset root: ${path}")
        endif()
        string(JSON sha GET "${manifest}" files ${index} sha256)
        string(JSON url GET "${manifest}" files ${index} source)
        kgfx_download_verified("${url}" "${sha}" "${root}/${path}")
    endforeach()
endfunction()

function(kgfx_tool_source name result)
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../deps/toolchain-lock.json" lock)
    string(JSON count LENGTH "${lock}" dependencies)
    math(EXPR last "${count}-1")
    foreach(i RANGE ${last})
        string(JSON candidate GET "${lock}" dependencies ${i} name)
        if(NOT candidate STREQUAL name)
            continue()
        endif()
        string(JSON kind ERROR_VARIABLE no_kind GET "${lock}" dependencies ${i} kind)
        if(kind STREQUAL "submodule")
            string(JSON path GET "${lock}" dependencies ${i} path)
            get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
            set(copy "${PROJECT_BINARY_DIR}/deps-src/${name}")
            kgfx_fork_source("${root}/${path}" "${name}" "${copy}" identity)
            set(${result} "${copy}" PARENT_SCOPE)
            return()
        endif()
        foreach(field IN ITEMS revision url sha256)
            string(JSON ${field} GET "${lock}" dependencies ${i} ${field})
        endforeach()
        set(cache "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../deps/cache")
        set(archive "${cache}/${name}-${revision}.tar.gz")
        kgfx_download_verified("${url}" "${sha256}" "${archive}")
        file(LOCK "${cache}/${name}-${revision}.extract.lock" GUARD FUNCTION TIMEOUT 1200)
        set(source "${cache}/sources/${name}-${revision}")
        if(NOT EXISTS "${source}/.kgfx-verified")
            set(staging "${cache}/sources/${name}-${revision}.partial")
            file(REMOVE_RECURSE "${staging}")
            file(MAKE_DIRECTORY "${staging}")
            file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${staging}")
            file(GLOB entries LIST_DIRECTORIES TRUE "${staging}/*")
            list(LENGTH entries length)
            if(NOT length EQUAL 1)
                message(FATAL_ERROR "Expected one root in ${archive}")
            endif()
            list(GET entries 0 extracted)
            file(REMOVE_RECURSE "${source}")
            file(RENAME "${extracted}" "${source}")
            file(WRITE "${source}/.kgfx-verified" "${sha256}\n")
            file(REMOVE_RECURSE "${staging}")
        endif()
        file(READ "${source}/.kgfx-verified" extracted_sha)
        string(STRIP "${extracted_sha}" extracted_sha)
        if(NOT extracted_sha STREQUAL sha256)
            message(FATAL_ERROR "Cached source marker differs from locked archive SHA256: ${source}; retain the archive and restore the source cache before retrying")
        endif()
        # Build copies isolate external code generation from verified sources.
        set(copy "${PROJECT_BINARY_DIR}/deps-src/${name}")
        if(NOT EXISTS "${copy}/.kgfx-revision")
            file(MAKE_DIRECTORY "${copy}")
            file(COPY "${source}/" DESTINATION "${copy}")
            file(WRITE "${copy}/.kgfx-revision" "${revision}\n")
        else()
            file(READ "${copy}/.kgfx-revision" old_revision)
            string(STRIP "${old_revision}" old_revision)
            if(NOT old_revision STREQUAL revision)
                message(FATAL_ERROR "Dependency ${name} pin changed; clean selected build tree before configuring")
            endif()
        endif()
        file(READ "${copy}/.kgfx-verified" copied_sha)
        string(STRIP "${copied_sha}" copied_sha)
        if(NOT copied_sha STREQUAL sha256)
            message(FATAL_ERROR "Dependency ${name} archive hash changed; clean selected build tree before configuring")
        endif()
        set(${result} "${copy}" PARENT_SCOPE)
        return()
    endforeach()
    message(FATAL_ERROR "Unknown locked tool dependency ${name}")
endfunction()
