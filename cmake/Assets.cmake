include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/AcquireInputs.cmake")
function(kgfx_add_asset_tools)
    if(TARGET kgfx_asset_cooker)
        return()
    endif()
    if(CMAKE_CROSSCOMPILING)
        if(NOT KSTAR_GFX_HOST_TOOLS)
            message(FATAL_ERROR "Set KSTAR_GFX_HOST_TOOLS to the completed native host build directory")
        endif()
        find_program(host_cooker NAMES kgfx_asset_cooker HINTS "${KSTAR_GFX_HOST_TOOLS}/bin/Release"
            "${KSTAR_GFX_HOST_TOOLS}/Release" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
        add_executable(kgfx_asset_cooker IMPORTED GLOBAL)
        set_target_properties(kgfx_asset_cooker PROPERTIES IMPORTED_LOCATION "${host_cooker}")
        return()
    endif()
    foreach(name IN ITEMS cgltf stb tinyexr mikktspace)
        kgfx_tool_source(${name} ${name}_src)
    endforeach()
    set(tools "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools")
    add_executable(kgfx_asset_cooker "${tools}/asset_cooker.cpp"
        "${tinyexr_src}/deps/miniz/miniz.c" "${mikktspace_src}/mikktspace.c")
    target_compile_features(kgfx_asset_cooker PRIVATE cxx_std_23)
    if(MSVC)
        target_compile_options(kgfx_asset_cooker PRIVATE /fp:strict)
    else()
        target_compile_options(kgfx_asset_cooker PRIVATE -ffp-contract=off)
    endif()
    set_target_properties(kgfx_asset_cooker PROPERTIES CXX_EXTENSIONS OFF)
    target_include_directories(kgfx_asset_cooker SYSTEM PRIVATE "${cgltf_src}" "${stb_src}"
        "${tinyexr_src}" "${tinyexr_src}/deps/miniz" "${mikktspace_src}")
    target_include_directories(kgfx_asset_cooker PRIVATE "${tools}/include")
    find_package(Threads REQUIRED)
    target_link_libraries(kgfx_asset_cooker PRIVATE Threads::Threads)
    if(BUILD_TESTING)
        add_test(NAME kgfx_asset_cooker_math COMMAND kgfx_asset_cooker --self-test)
    endif()
endfunction()
function(kgfx_prepare_assets output_variable)
    kgfx_add_asset_tools()
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    set(source "${root}/assets/source")
    set(cooked "${root}/assets/cooked")
    kgfx_acquire_manifest("${source}" "${root}/assets/manifest.json")
    file(READ "${root}/assets/manifest.json" manifest)
    string(JSON count LENGTH "${manifest}" files)
    math(EXPR last "${count}-1")
    set(inputs)
    foreach(i RANGE ${last})
        string(JSON file GET "${manifest}" files ${i} file)
        list(APPEND inputs "${source}/${file}")
    endforeach()
    add_custom_command(OUTPUT "${cooked}/cook.stamp"
        COMMAND "${Python3_EXECUTABLE}" "${root}/tools/cook_assets.py"
            --cooker $<TARGET_FILE:kgfx_asset_cooker> --source "${source}" --output "${cooked}"
            --manifest "${root}/assets/manifest.json"
        DEPENDS kgfx_asset_cooker ${inputs} "${root}/assets/manifest.json"
            "${root}/tools/asset_cooker.cpp" "${root}/tools/include/kgfx_asset_format.h"
            "${root}/tools/cook_assets.py"
        VERBATIM COMMENT "Cooking verified model textures and floating-point image-based lighting")
    add_custom_target(kgfx_assets DEPENDS "${cooked}/cook.stamp")
    if(BUILD_TESTING)
        add_test(NAME kgfx_acquisition COMMAND "${Python3_EXECUTABLE}" "${root}/tools/test_acquisition.py" --cmake "${CMAKE_COMMAND}")
        add_test(NAME kgfx_fork_sources COMMAND "${Python3_EXECUTABLE}" "${root}/tools/test_fork_sources.py")
        add_test(NAME kgfx_resource_packaging COMMAND "${Python3_EXECUTABLE}" "${root}/tools/test_packaging.py")
        add_test(NAME kgfx_cooked_assets COMMAND "${Python3_EXECUTABLE}" "${root}/tools/test_assets.py" "${cooked}")
        set_tests_properties(kgfx_cooked_assets PROPERTIES TIMEOUT 120 LABELS "assets")
    endif()
    set(${output_variable} "${cooked}" PARENT_SCOPE)
endfunction()
