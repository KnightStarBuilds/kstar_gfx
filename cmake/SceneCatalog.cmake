include_guard(GLOBAL)
find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(KGFX_SCENE_CATALOG "${CMAKE_CURRENT_LIST_DIR}/../assets/scenes.json")
set(KGFX_SCENE_GENERATOR "${CMAKE_CURRENT_LIST_DIR}/../tools/scene_catalog.py")
set(KGFX_SCENE_INCLUDE_DIR "${CMAKE_BINARY_DIR}/generated")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KGFX_SCENE_CATALOG}" "${KGFX_SCENE_GENERATOR}")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${KGFX_SCENE_GENERATOR}"
    --catalog "${KGFX_SCENE_CATALOG}" --header "${KGFX_SCENE_INCLUDE_DIR}/kgfx_scene_catalog.hpp" --list
    OUTPUT_VARIABLE KGFX_SCENES OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)

execute_process(COMMAND "${Python3_EXECUTABLE}" "${KGFX_SCENE_GENERATOR}" --list-legacy
    OUTPUT_VARIABLE KGFX_LEGACY_SCENES OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${Python3_EXECUTABLE}" "${KGFX_SCENE_GENERATOR}" --list-showcase
    OUTPUT_VARIABLE KGFX_SHOWCASE_SCENES OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
