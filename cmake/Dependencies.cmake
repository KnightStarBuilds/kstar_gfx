include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/AcquireInputs.cmake")
function(kgfx_dependency name result)
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../deps/lock.json" manifest)
    string(JSON count LENGTH "${manifest}" dependencies)
    math(EXPR last "${count}-1")
    foreach(i RANGE ${last})
        string(JSON entry GET "${manifest}" dependencies ${i} name)
        if(NOT entry STREQUAL name)
            continue()
        endif()
        foreach(field IN ITEMS version url archive sha256)
            string(JSON ${field} GET "${manifest}" dependencies ${i} ${field})
        endforeach()
        set(cache "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../deps/cache")
        kgfx_download_verified("${url}" "${sha256}" "${cache}/${archive}")
        set(source "${cache}/sources/${name}-${version}")
        file(LOCK "${cache}/${name}.extract.lock" GUARD FUNCTION TIMEOUT 600)
        if(NOT EXISTS "${source}/.kgfx-verified")
            file(REMOVE_RECURSE "${source}.partial")
            file(MAKE_DIRECTORY "${source}.partial")
            file(ARCHIVE_EXTRACT INPUT "${cache}/${archive}" DESTINATION "${source}.partial")
            file(GLOB roots LIST_DIRECTORIES TRUE "${source}.partial/*")
            list(LENGTH roots root_count)
            if(NOT root_count EQUAL 1)
                message(FATAL_ERROR "Expected one archive root for ${name}")
            endif()
            list(GET roots 0 extracted)
            file(REMOVE_RECURSE "${source}")
            file(RENAME "${extracted}" "${source}")
            file(WRITE "${source}/.kgfx-verified" "${sha256}\n")
            file(REMOVE_RECURSE "${source}.partial")
        endif()
        file(READ "${source}/.kgfx-verified" extracted_sha)
        string(STRIP "${extracted_sha}" extracted_sha)
        if(NOT extracted_sha STREQUAL sha256)
            message(FATAL_ERROR "Cached ${name} source marker does not match locked SHA256")
        endif()
        set(copy "${PROJECT_BINARY_DIR}/deps-src/${name}")
        if(NOT EXISTS "${copy}/.kgfx-verified")
            file(MAKE_DIRECTORY "${copy}")
            file(COPY "${source}/" DESTINATION "${copy}")
        endif()
        file(READ "${copy}/.kgfx-verified" copied_sha)
        string(STRIP "${copied_sha}" copied_sha)
        if(NOT copied_sha STREQUAL sha256)
            message(FATAL_ERROR "${name} pin changed: clean the selected build tree")
        endif()
        set(${result} "${copy}" PARENT_SCOPE)
        return()
    endforeach()
    message(FATAL_ERROR "Unknown dependency ${name}")
endfunction()

function(kgfx_add_sdl)
    if(TARGET SDL2::SDL2-static)
        return()
    endif()
    kgfx_dependency(sdl2 sdl_source)
    set(SDL_SHARED OFF CACHE BOOL "" FORCE)
    set(SDL_STATIC ON CACHE BOOL "" FORCE)
    set(SDL_TEST OFF CACHE BOOL "" FORCE)
    set(SDL_TESTS OFF CACHE BOOL "" FORCE)
    set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
    set(SDL2_DISABLE_INSTALL ON CACHE BOOL "" FORCE)
    set(SDL2_DISABLE_SDL2MAIN ON CACHE BOOL "" FORCE)
    add_subdirectory("${sdl_source}" "${PROJECT_BINARY_DIR}/deps/sdl2" EXCLUDE_FROM_ALL)
endfunction()
